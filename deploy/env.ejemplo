# Configuración de producción (docs/despliegue.md). Copiar como .env en la raíz del repo:
#   cp deploy/env.ejemplo .env && chmod 600 .env
# .env no se sube a git.

# Dominio público. Caddy pide el certificado para este nombre y la API solo acepta pedidos de él.
DOMINIO=stock.hardhouse.com.ar

# Postgres de Supabase: botón "Connect" → "Session pooler" → copiar la URI y poner la contraseña.
# Si la contraseña tiene símbolos (@ # / : ? %), van codificados (%40, %23…).
# Cada cliente tiene SU PROPIA base: nunca repetir la de otra instalación.
DATABASE_URL=

# --- Cliente (docs/clientes.md) ---
# Sin estas variables, la instalación es la de La Frontera, como siempre.
# Cuál cliente: logo, colores, medios de pago y funcionalidades (la-frontera, bella-esencia…).
CLIENTE=la-frontera
# Nombre de la instalación en Docker (contenedores, imágenes y volúmenes). Uno distinto por cliente.
NOMBRE_PROYECTO=stock
# Puertos de Caddy en 127.0.0.1, a los que el portero manda el tráfico. Distintos por instalación.
PUERTO_HTTP=8081
PUERTO_HTTPS=8444

# Opcionales (estos son los valores por defecto)
SESION_HORAS=12
BCRYPT_COSTO=12
