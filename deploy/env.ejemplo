# Configuración de producción (docs/despliegue.md). Copiar como .env en la raíz del repo:
#   cp deploy/env.ejemplo .env && chmod 600 .env
# .env no se sube a git.

# Dominio público. Caddy pide el certificado para este nombre y la API solo acepta pedidos de él.
DOMINIO=stock.hardhouse.com.ar

# Postgres de Supabase: botón "Connect" → "Session pooler" → copiar la URI y poner la contraseña.
# Si la contraseña tiene símbolos (@ # / : ? %), van codificados (%40, %23…).
DATABASE_URL=

# Opcionales (estos son los valores por defecto)
SESION_HORAS=12
BCRYPT_COSTO=12
