# Copiar este archivo como .env y completar los valores.

# Puerto donde escucha la API
PORT=4100

# Orígenes que pueden llamar a la API (separados por coma)
CORS_ORIGIN=http://localhost:3100

# Conexión a Postgres de Supabase.
# Panel de Supabase → botón "Connect" → "Session pooler" → copiar la URI
# y reemplazar [YOUR-PASSWORD] por la contraseña de la base.
# Si queda vacío, la API arranca igual pero sin base de datos.
DATABASE_URL=

# --- Seguridad (opcionales, estos son los valores por defecto) ---

# Horas que dura la sesión. Se renueva sola mientras se siga usando el sistema.
SESION_HORAS=12

# Costo de bcrypt para las contraseñas (10 a 15). Cada +1 duplica el tiempo de cálculo.
BCRYPT_COSTO=12

# Proxies en los que confía la API para saber la IP real del cliente.
# "loopback" = la web de Next en la misma máquina. En la nube, ajustar según el hosting.
TRUST_PROXY=loopback
