# Copiar este archivo como .env y completar los valores.

# Puerto donde escucha la API
PORT=4100

# Orígenes que pueden llamar a la API (separados por coma)
CORS_ORIGIN=http://localhost:3100

# Conexión a Postgres de Supabase.
# Panel de Supabase → botón "Connect" → "Session pooler" → copiar la URI
# y reemplazar [YOUR-PASSWORD] por la contraseña de la base.
# Si queda vacío, la API arranca igual pero sin base de datos.
DATABASE_URL=
