# Copiar este archivo como .env.local y completar los valores.

# Dirección de la API (sin /api al final). La web le reenvía los pedidos a /api/*.
# Se usa al compilar: en producción definirla antes de `npm run build`.
API_URL=http://localhost:4100

# Cliente por defecto de npm run dev (docs/clientes.md). Sin definir: la-frontera.
# Para cambiar de cliente, mejor npm run frontera / npm run bella, que lo eligen solos.
CLIENTE=la-frontera
